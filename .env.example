# --- AI providers (all optional; copy to .env and fill only what you buy) ---
# Router order = provider order. Default works with NO key (Ollama + null).
# When you buy a key, add it here and set the order, e.g.:
# AI_PROVIDER_ORDER=openai,anthropic,gemini,ollama
AI_PROVIDER_ORDER=ollama,none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Market data ---
# Fallback order for daily candles. nseapi = NseIndiaApi (pip install NseIndiaApi;
# primary on a normal/home network), yfinance = fallback, broker adapters Phase 1+.
DATA_PROVIDER_ORDER=nseapi,yfinance

# --- Safety ---
# TRADING_MODE is paper/live. paper never touches a broker.
TRADING_MODE=paper

# --- Telegram alerts (optional, Phase 4) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
